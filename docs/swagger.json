        "/characters": {
            "get": {
                "description": "Returns a map of character IDs to character names",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "List all characters",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/config": {
            "get": {
                "description": "Returns service configuration flags",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
