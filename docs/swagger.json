                    "items": {
                        "$ref": "#/definitions/dto.SearchResult"
                    }
                },
                "total": {
                    "description": "Total number of matches",
                    "type": "integer",
                    "example": 25
                }
            }
        },
        "dto.SearchResult": {
            "type": "object",
            "properties": {
                "quote": {
                    "description": "The matched quote",
