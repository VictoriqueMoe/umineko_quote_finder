Dialogue: 0,0:00:12.49,0:00:17.87,Romaji,,0,0,0,,hitorikiri de hiza o kakaete
Dialogue: 0,0:00:17.87,0:00:23.33,Romaji,,0,0,0,,ikiteru koto mo mienaku natteta
Dialogue: 0,0:00:23.33,0:00:28.34,Romaji,,0,0,0,,yogorekitta kienai kizu o
Dialogue: 0,0:00:28.34,0:00:33.74,Romaji,,0,0,0,,itametsukenagara nandomo nadeta
Dialogue: 0,0:00:33.74,0:00:39.89,Romaji,,0,0,0,,odayaka na kin’iro no yume   kaze ga kiita kotoba
Dialogue: 0,0:00:39.89,0:00:44.50,Romaji,,0,0,0,,yururi to mazariau you na yawaraka na omoi o
Dialogue: 0,0:00:44.50,0:00:49.90,Romaji,,0,0,0,,ame no hi mo, hare no hi mo, itsu no hi mo aishiteta
Dialogue: 0,0:00:49.90,0:00:55.32,Romaji,,0,0,0,,sore dake wa ima mo mada zutto kawari wa shinai
Dialogue: 0,0:00:55.32,0:01:00.95,Romaji,,0,0,0,,dakedo yakusoku wa hatasenai mama
Dialogue: 0,0:01:00.95,0:01:05.98,Romaji,,0,0,0,,yowai watashi o mamoru kokoro ga
Dialogue: 0,0:01:05.98,0:01:11.50,Romaji,,0,0,0,,sotto se o oshite hitori de mukau
Dialogue: 0,0:01:11.50,0:01:17.64,Romaji,,0,0,0,,ashita no hibi ga kagayake to waratta
Dialogue: 0,0:01:17.64,0:01:22.12,Romaji,,0,0,0,,itsuka, itsu no hi ka
Dialogue: 0,0:01:22.12,0:01:25.77,Romaji,,0,0,0,,waraeru hibi ni aruiteku
Dialogue: 0,0:01:25.77,0:01:29.61,Romaji,,0,0,0,,itsuka, itsu no hi ka...
Dialogue: 0,0:01:56.17,0:02:02.22,Romaji,,0,0,0,,kanashisa o kanjiru koto wa ima dake wa yurushite
Dialogue: 0,0:02:02.22,0:02:07.02,Romaji,,0,0,0,,owari no kowareta hibi o owari ni suru kara
Dialogue: 0,0:02:07.02,0:02:12.40,Romaji,,0,0,0,,ame no hi mo, hare no hi mo, itsu no hi mo suki datta
Dialogue: 0,0:02:12.40,0:02:17.78,Romaji,,0,0,0,,sore dake wa ima mo mada zutto kawari wa shinai
Dialogue: 0,0:02:17.78,0:02:23.83,Romaji,,0,0,0,,soshite yakusoku o shinji, yabureru
Dialogue: 0,0:02:23.83,0:02:28.71,Romaji,,0,0,0,,yowai kokoro o tsutsumu ryoute de
Dialogue: 0,0:02:28.71,0:02:34.21,Romaji,,0,0,0,,afureru namida   nugutte kureru
Dialogue: 0,0:02:34.21,0:02:38.63,Romaji,,0,0,0,,yasashii anata ni tsutaeru n da
