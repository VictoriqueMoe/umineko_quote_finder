        "dto.SpeakerStat": {
            "type": "object",
            "properties": {
                "characterId": {
                    "description": "Numeric character identifier",
                    "type": "string",
                    "example": "10"
                },
                "count": {
                    "description": "Number of dialogue lines",
                    "type": "integer",
                    "example": 4304
                },
                "name": {
                    "description": "Display name of the character",
                    "type": "string",
                    "example": "Ushiromiya Battler"
                }
            }
        },
        "dto.StatsResult": {
            "type": "object",
            "properties": {
                "characterNames": {
                    "description": "Map of character ID to display name",
