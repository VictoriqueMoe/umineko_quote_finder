Dialogue: 0,0:00:00.00,0:00:06.19,Italian,,0,0,0,,Oh anima effimera
Dialogue: 0,0:00:06.19,0:00:15.57,Italian,,0,0,0,,che ti celi nel profondo dell’inganno,
Dialogue: 0,0:00:15.57,0:00:29.05,Italian,,0,0,0,,chi hai continuato ad aspettare nel bosco deserto?
Dialogue: 0,0:00:29.05,0:00:31.80,Italian,,0,0,0,,Privato di un’ala,
Dialogue: 0,0:00:31.80,0:00:41.52,Italian,,0,0,0,,l’uccellino ha chiuso gli occhi in silenzio
Dialogue: 0,0:00:41.52,0:00:47.61,Italian,,0,0,0,,La sofferenza è svanita lontano;
Dialogue: 0,0:00:47.61,0:00:54.11,Italian,,0,0,0,,ora l’uccellino non piange più
Dialogue: 0,0:00:54.11,0:01:00.24,Italian,,0,0,0,,Una morbida nebbia d’argento
Dialogue: 0,0:01:00.24,0:01:06.37,Italian,,0,0,0,,Una morbida nebbia d’argento
Dialogue: 0,0:01:06.37,0:01:15.05,Italian,,0,0,0,,avvolge teneramente ogni cosa
Dialogue: 0,0:01:15.05,0:01:20.05,Italian,,0,0,0,,Riposa, riposa in pace
Dialogue: 0,0:01:20.05,0:01:27.31,Italian,,0,0,0,,Nel racconto che ho scritto, puoi volare in libertà
Dialogue: 0,0:01:27.31,0:01:35.74,Italian,,0,0,0,,Ecco il mio ultimo incantesimo,
Dialogue: 0,0:01:35.74,0:01:47.04,Italian,,0,0,0,,affinché la tua luce non conosca ombra
Dialogue: 0,0:01:47.04,0:01:59.59,Italian,,0,0,0,,Che lo splendido sogno dorato non venga infangato
Dialogue: 0,0:01:59.59,0:02:10.56,Italian,,0,0,0,,dalla tristezza apportata dalla verità
Dialogue: 0,0:02:10.56,0:02:15.44,Italian,,0,0,0,,Riposa, riposa in pace
Dialogue: 0,0:02:15.44,0:02:22.78,Italian,,0,0,0,,Nel racconto che ho scritto, puoi volare in libertà
Dialogue: 0,0:02:22.78,0:02:31.33,Italian,,0,0,0,,Ecco il mio ultimo incantesimo,
Dialogue: 0,0:02:31.33,0:02:42.43,Italian,,0,0,0,,affinché la tua luce non conosca ombra