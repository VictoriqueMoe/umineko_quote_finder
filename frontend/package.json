{
    "name": "umineko-quote-finder",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "oxlint --type-aware --type-check --max-warnings=0 --disable-nested-config .",
        "lint:fix": "oxlint --disable-nested-config . --fix",
        "format": "oxfmt --check ./src",
        "format:fix": "oxfmt ./src"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "chart.js": "^4.6.1",
        "chartjs-plugin-zoom": "^2.2.0",
        "hammerjs": "^2.0.8",
        "react": "^19.3.1",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    }
