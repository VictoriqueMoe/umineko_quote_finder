                        "$ref": "#/definitions/dto.CharacterPresence"
                    }
                },
                "episodeNames": {
                    "description": "Map of episode number to title",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "interactionCounts": {
                    "description": "Full interaction map keyed by \"charA|charB\"",
