Dialogue: 0,0:00:00.00,0:00:03.13,Romaji,,0,0,0,,Né regole   Né comandamenti   Né ragione
Dialogue: 0,0:00:03.13,0:00:05.91,Romaji,,0,0,0,,In altre parole: imprevedibile
Dialogue: 0,0:00:05.91,0:00:11.30,Romaji,,0,0,0,,Ma succede   Cose spiacevoli succedono   E io ne sono la causa
Dialogue: 0,0:00:11.30,0:00:14.60,Romaji,,0,0,0,,Ancora non capisci?
Dialogue: 0,0:00:14.60,0:00:16.46,Romaji,,0,0,0,,Niente di cui nutrirmi
Dialogue: 0,0:00:16.46,0:00:19.55,Romaji,,0,0,0,,Mi fanno morire di fame
Dialogue: 0,0:00:19.55,0:00:27.56,Romaji,,0,0,0,,Mi fanno morire credendo di poter prevedere
Dialogue: 0,0:00:27.56,0:00:30.71,Romaji,,0,0,0,,yo wo watariyuku tsuki ni
Dialogue: 0,0:00:30.71,0:00:34.03,Romaji,,0,0,0,,shio wa takaku michite
Dialogue: 0,0:00:34.03,0:00:37.12,Romaji,,0,0,0,,umineko no naku koe wa
Dialogue: 0,0:00:37.12,0:00:40.67,Romaji,,0,0,0,,fuon no kumo wo maneku
Dialogue: 0,0:00:40.67,0:00:43.95,Romaji,,0,0,0,,konjiki no noroi to
Dialogue: 0,0:00:43.95,0:00:46.95,Romaji,,0,0,0,,nokosareshi kotoba to
Dialogue: 0,0:00:46.95,0:00:50.23,Romaji,,0,0,0,,himeyaka na hohoemi wa
Dialogue: 0,0:00:50.23,0:00:53.54,Romaji,,0,0,0,,kurenai ni nijimu
Dialogue: 0,0:00:53.54,0:01:00.44,Romaji,,0,0,0,,tozasareta hitomi de nani wo motometeru
Dialogue: 0,0:01:00.44,0:01:06.30,Romaji,,0,0,0,,kowareta sono kakera wo atsumete mite mo
Dialogue: 0,0:01:06.30,0:01:10.40,Romaji,,0,0,0,,fureta yubi wo koboreru
Dialogue: 0,0:01:10.40,0:01:13.29,Romaji,,0,0,0,,kimi ni todokanai
Dialogue: 0,0:01:13.29,0:01:16.39,Romaji,,0,0,0,,kazarareta kyojitsu
Dialogue: 0,0:01:16.39,0:01:18.44,Romaji,,0,0,0,,ai ga nakereba mienai
Dialogue: 0,0:01:18.44,0:01:26.70,Romaji,,0,0,0,,Senza amore, senza amore la verità non si vede
