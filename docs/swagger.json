                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "Get quote statistics",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Filter by episode (1-8), 0 for all",
                        "name": "episode",
                        "in": "query"
                    }
