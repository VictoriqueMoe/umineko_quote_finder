                "charB": {
                    "description": "Second character ID",
                    "type": "string",
                    "example": "27"
                },
                "count": {
                    "description": "Number of adjacent dialogue exchanges",
                    "type": "integer",
                    "example": 1701
                },
                "nameA": {
                    "description": "First character name",
                    "type": "string",
                    "example": "Ushiromiya Battler"
                },
                "nameB": {
                    "description": "Second character name",
                    "type": "string",
                    "example": "Beatrice"
                }
            }
        },
        "dto.SearchAPIResponse": {
            "type": "object",
            "properties": {
                "limit": {
                    "description": "Maximum results per page",
                    "type": "integer",
                    "example": 30
                },
                "offset": {
                    "description": "Pagination offset",
                    "type": "integer",
                    "example": 0
                },
                "query": {
                    "description": "The search query that was used",
                    "type": "string",
                    "example": "without love"
