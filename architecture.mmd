    style LexarPipeline fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    style DataLoading fill:#ede7f6,stroke:#6a1b9a,color:#4a148c
    style AudioProc fill:#fce4ec,stroke:#c62828,color:#b71c1c
    style OGImage fill:#fff3e0,stroke:#e65100,color:#bf360c
    style CICD fill:#f3e5f5,stroke:#7b1fa2,color:#4a148c
    style DTOs fill:#eceff1,stroke:#546e7a,color:#37474f
