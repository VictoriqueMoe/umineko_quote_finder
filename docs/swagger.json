    "definitions": {
        "dto.CharacterPresence": {
            "type": "object",
            "properties": {
                "characterId": {
                    "description": "Numeric character identifier",
                    "type": "string",
                    "example": "10"
                },
                "episodes": {
                    "description": "Line counts per episode (index 0 = ep 1)",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "name": {
                    "description": "Display name of the character",
                    "type": "string",
                    "example": "Ushiromiya Battler"
                }
            }
        },
        "dto.CharacterResponse": {
            "type": "object",
            "properties": {
                "character": {
                    "description": "Display name of the character",
                    "type": "string",
                    "example": "Ushiromiya Battler"
                },
                "characterId": {
                    "description": "Numeric character identifier",
                    "type": "string",
                    "example": "10"
                },
                "limit": {
                    "description": "Maximum results per page",
                    "type": "integer",
                    "example": 50
                },
                "offset": {
                    "description": "Pagination offset",
                    "type": "integer",
                    "example": 0
                },
                "quotes": {
                    "description": "Paginated list of quotes",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/umineko_quote_internal_dto.ParsedQuote"
                    }
                },
                "total": {
                    "description": "Total number of matching quotes",
                    "type": "integer",
                    "example": 4304
                }
            }
        },
        "dto.ContextResponse": {
            "type": "object",
            "properties": {
                "after": {
                    "description": "Dialogue lines after the target quote",
