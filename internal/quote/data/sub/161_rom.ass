Dialogue: 0,0:00:17.94,0:00:22.49,Romaji,,0,0,0,,{\alpha&HBB}ecchira ochira sa   kamome no nakigoe kikitsutsu
Dialogue: 0,0:00:22.49,0:00:26.99,Romaji,,0,0,0,,{\alpha&HBB}donbura donbura to   nami ni yurare yuku shima wa
Dialogue: 0,0:00:26.99,0:00:28.58,Romaji,,0,0,0,,{\alpha&HBB}okaruto airando
Dialogue: 0,0:00:28.58,0:00:31.71,Romaji,,0,0,0,,{\alpha&HBB}takanaru kokoro mo osaezu...
Dialogue: 0,0:00:31.71,0:00:36.32,Romaji,,0,0,0,,{\alpha&HBB}yorokobi ga unaru! chishikiyoku kamishimete!
Dialogue: 0,0:00:40.72,0:00:45.22,Romaji,,0,0,0,,nandomo nandomo sa   noroi no shomotsu yomiasatte mo
Dialogue: 0,0:00:45.22,0:00:49.85,Romaji,,0,0,0,,dou ni mo kou ni mo ne   wakannee koto bakari aru
Dialogue: 0,0:00:49.85,0:00:51.52,Romaji,,0,0,0,,...ga! Goodbye nayami!
Dialogue: 0,0:00:51.52,0:00:54.48,Romaji,,0,0,0,,sayounara hikikomori no hibi
Dialogue: 0,0:00:54.48,0:00:59.16,Romaji,,0,0,0,,nengan no nazo no kotou ni tadoritsuita!
Dialogue: 0,0:01:03.57,0:01:08.28,Romaji,,0,0,0,,kaidoku dekita watashi nomi wo yurusu hiroma wa
Dialogue: 0,0:01:08.28,0:01:09.87,Romaji,,0,0,0,,nantomo mabayui...
Dialogue: 0,0:01:09.87,0:01:12.71,Romaji,,0,0,0,,doko kashiko mo ougon! ougon!
Dialogue: 0,0:01:12.71,0:01:17.29,Romaji,,0,0,0,,Yahoo! Pa Pa Ya! Ah...
Dialogue: 0,0:01:17.29,0:01:22.01,Romaji,,0,0,0,,kindan no etsuraku de aru to shirinagara
Dialogue: 0,0:01:31.14,0:01:38.15,Romaji,,0,0,0,,(null sieben fünfzehn elf neunundzwanzig)
Dialogue: 0,0:01:49.37,0:01:53.83,Romaji,,0,0,0,,dongara byunbyun to   iya na oto ga kikoete kuru
Dialogue: 0,0:01:53.83,0:01:58.34,Romaji,,0,0,0,,masaka masaka na   dare mo inai hazu na no ni
Dialogue: 0,0:01:58.34,0:02:00.05,Romaji,,0,0,0,,kono shima nan nan sa...
Dialogue: 0,0:02:00.05,0:02:03.01,Romaji,,0,0,0,,wakideru fuan o yosome ni
Dialogue: 0,0:02:03.01,0:02:07.64,Romaji,,0,0,0,,ashidori wa oku e oku e to hikikomarete...
Dialogue: 0,0:02:12.22,0:02:13.81,Romaji,,0,0,0,,konjiki chouchou ni
Dialogue: 0,0:02:13.81,0:02:16.83,Romaji,,0,0,0,,matowaritsuku nanatsu no kui
Dialogue: 0,0:02:16.83,0:02:18.44,Romaji,,0,0,0,,bureedo ni bariyaa ni
Dialogue: 0,0:02:18.44,0:02:21.23,Romaji,,0,0,0,,akai moji yara aoi moji...
Dialogue: 0,0:02:21.23,0:02:25.90,Romaji,,0,0,0,,konrinzai yameta! sayounara okaruto no shima yo
Dialogue: 0,0:02:25.90,0:02:30.41,Romaji,,0,0,0,,mou nido to tachiiru koto wa shimasen kara...
Dialogue: 0,0:02:35.08,0:02:38.42,Romaji,,0,0,0,,{\alpha&HBB}tojikomerarete chibiru watashi
Dialogue: 0,0:02:38.42,0:02:39.63,Romaji,,0,0,0,,{\alpha&HBB}sakebu kotoba ga...
Dialogue: 0,0:02:39.63,0:02:41.29,Romaji,,0,0,0,,{\alpha&HBB}koko wa doko?!
Dialogue: 0,0:02:41.29,0:02:44.13,Romaji,,0,0,0,,{\alpha&HBB}majo darake no hentai kuukan?!
Dialogue: 0,0:02:44.13,0:02:48.68,Romaji,,0,0,0,,{\alpha&HBB}Oh No! My God... Ha...!!
Dialogue: 0,0:02:48.68,0:02:53.43,Romaji,,0,0,0,,{\alpha&HBB}densetsu wa usan no mi to tomo ni kakusarete
Dialogue: 0,0:03:02.57,0:03:09.24,Romaji,,0,0,0,,{\alpha&HBB}(null sieben fünfzehn elf neunundzwanzig)
